# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (ห้าม commit .env.local)

# ---- AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# ตั้งเป็น 1 เพื่อใช้ผล AI จาก data/demo-cache.json แทนการเรียก OpenAI (กรณีเน็ตในงานมีปัญหา)
DEMO_OFFLINE=

# ---- Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role: ใช้ฝั่ง server เท่านั้น ห้ามขึ้นต้นด้วย NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# ใช้กับ supabase CLI (link / db push) เท่านั้น
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# ---- บัญชีเดโม
# รหัสผ่านของบัญชีเดโมทุกบัญชี (npm run db:seed ตั้งให้) — ปุ่มล็อกอินเดโมใช้ค่านี้ฝั่ง server
DEMO_PASSWORD=
# 1 = เปิดหน้า/ปุ่มล็อกอินบัญชีเดโมในคลิกเดียว (ปิดเมื่อใช้งานจริง)
DEMO_LOGIN=1
